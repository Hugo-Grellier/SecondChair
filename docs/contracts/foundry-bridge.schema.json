        "base": {
          "type": "string",
          "pattern": "^(Compendium\\.[\\w-]+\\.[\\w-]+\\.)?\\w+\\.[A-Za-z0-9]+$",
          "description": "The UUID of the compendium or world document it is made from, `data` set on top."
        },
        "data": {
          "type": "object",
          "description": "The document's fields, never `ownership` (a disclosure: publish_journal); a JournalEntry text page may give `text.markdown`, stored as sanitized HTML."
        },
        "choice": {
          "enum": [
            "keep",
            "overwrite",
            "recreate"
          ],
          "description": "The GM's call: keep the VTT's version of a conflict, overwrite it, or recreate the document deleted in Foundry."
        }
      },
      "required": [
        "type",
        "data"
      ],
      "additionalProperties": false
    }
