    "desk_call": {
      "type": "object",
      "description": "A call on the GM as the Desk shows it (call.schema.json), with what its action entry would do.",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "proposal",
            "exception",
            "ceiling_refusal"
          ]
        },
        "responsibility": {
          "type": "string"
        },
        "deadline": {
          "enum": [
            "now",
            "break"
          ]
        },
        "status": {
          "enum": [
            "open",
            "answered",
            "defaulted",
            "withdrawn"
          ]
        },
        "entry": {
          "type": [
            "integer",
            "null"
          ],
          "description": "The action log entry a proposal approves or rejects."
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ],
          "description": "The entry's tool, agent, target and content, cut to 400 characters; null without an entry."
        },
        "reversible": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether the entry's action can be undone; null without an entry."
        }
      },
      "required": [
        "id",
        "kind",
        "responsibility",
        "deadline",
        "status",
        "entry",
        "message",
        "detail",
        "reversible"
      ],
      "additionalProperties": false
    },
    "desired_document": {
      "title": "desired document",
      "description": "What prep asks a world document to be (a workspace's documents/<key>.yaml). The Foundry connector gives the data its meaning: Foundry document fields.",
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "JournalEntry",
            "Actor",
            "Item",
            "Playlist",
            "RollTable"
          ]
