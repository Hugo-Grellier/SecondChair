{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hugo-Grellier/SecondChair/blob/main/docs/contracts/foundry-bridge.schema.json",
  "title": "Foundry bridge message",
  "description": "One message on the Core's /foundry WebSocket (docs/contracts/foundry-bridge.md): the handshake, then requests and replies, the live session and observations, and the scenes and world documents to realise, and behaviour traces.",
  "oneOf": [
    {
      "title": "hello",
      "description": "Sent once by the module in the GM's browser, right after the socket opens.",
      "type": "object",
      "properties": {
        "type": {
          "const": "hello"
        },
        "protocol": {
          "type": "string",
          "description": "The protocol version the module implements (semver)."
        },
        "token": {
          "type": "string",
          "description": "The token printed by `secondchair token`."
        },
        "world": {
          "type": "string",
          "minLength": 1,
          "description": "The Foundry world id."
        },
        "campaign": {
          "type": [
            "string",
            "null"
          ],
          "description": "The campaign id stored in the world, or null when the world is not bound."
        }
      },
      "required": [
        "type",
        "protocol",
        "token",
        "world",
        "campaign"
      ],
      "additionalProperties": false
    },
    {
      "title": "welcome",
      "description": "The Core accepts the connection. The module stores `campaign` in the world.",
      "type": "object",
      "properties": {
        "type": {
          "const": "welcome"
        },
        "protocol": {
          "type": "string",
          "description": "The Core's protocol version."
        },
        "campaign": {
          "type": "string",
          "minLength": 1
        },
        "campaign_language": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "protocol",
        "campaign",
        "campaign_language"
      ],
      "additionalProperties": false
    },
    {
      "title": "refused",
      "description": "The Core refuses the connection, then closes the socket.",
      "type": "object",
      "properties": {
        "type": {
          "const": "refused"
        },
        "reason": {
          "enum": [
            "malformed",
            "no_token",
            "wrong_token",
            "protocol",
            "busy",
            "world"
          ]
        },
        "message": {
          "type": "string",
          "description": "A message for the GM, in English."
        }
      },
      "required": [
        "type",
        "reason",
        "message"
      ],
      "additionalProperties": false
    },
    {
      "title": "request",
      "description": "The Core asks the GM client to take one action in the VTT.",
      "type": "object",
      "properties": {
        "type": {
          "const": "request"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "The request id. A request id already handled is never applied again: its first reply is sent back."
        },
        "op": {
          "type": "string",
          "minLength": 1,
          "description": "The operation: a generic one of the library (move_token, set_door, reveal_token, publish_journal, speak, whisper) or a mechanical one, handled by the system adapter (PF2e: set_actor, set_date, strike, use_action, saving_throw, cast_spell, self_effect, place_area, reaction)."
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "The Foundry UUID of the document acted on. `time` for the world clock (`set_date`)."
        },
        "params": {
          "type": "object",
          "description": "The fields to set."
        },
        "expect": {
          "type": [
            "object",
            "null"
          ],
          "description": "The fields the document must still have, or the action is refused (an undo after a hand edit); null to skip the check."
        },
        "level": {
          "enum": [
            "manual",
            "propose",
            "act-then-review",
            "autonomous",
            null
          ],
          "description": "The delegation level the Core takes the action at, which the module checks against the world's ceiling (DEL-19); null for the GM's own undo, which the ceiling does not bound."
        }
      },
      "required": [
        "type",
        "id",
        "op",
        "target",
        "params",
        "expect",
        "level"
      ],
      "additionalProperties": false
    },
    {
      "title": "read",
      "description": "The Core asks the GM client something only the VTT knows. Nothing changes in the VTT, so a read is neither queued nor recorded as handled.",
      "type": "object",
      "properties": {
        "type": {
          "const": "read"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "type": "string",
          "minLength": 1,
          "description": "What to read: browse_files, search_compendium, list_world_documents, answered by the library; rules_context, official_name, answered by the system adapter."
        },
        "params": {
          "type": "object"
        }
      },
      "required": [
        "type",
        "id",
        "op",
        "params"
      ],
      "additionalProperties": false
    },
    {
      "title": "reply",
      "description": "The GM client's answer to a request or a read.",
      "type": "object",
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "reply"
            },
            "id": {
              "type": "string"
            },
            "ok": {
              "const": true
            },
            "before": {
              "type": "object",
              "description": "The fields before the action."
            },
            "after": {
              "type": "object",
              "description": "The fields after the action."
            }
          },
          "required": [
            "type",
            "id",
            "ok",
            "before",
            "after"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "reply"
            },
            "id": {
              "type": "string"
            },
            "ok": {
              "const": true
            },
            "result": {
              "description": "What the read found."
            }
          },
          "required": [
            "type",
            "id",
            "ok",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "reply"
            },
            "id": {
              "type": "string"
            },
            "ok": {
              "const": false
            },
            "error": {
              "type": "string",
              "description": "Why the action failed, for the GM, in English."
            },
            "reason": {
              "const": "ceiling",
              "description": "Present when the world's ceiling refused the action (DEL-20)."
            }
          },
          "required": [
            "type",
            "id",
            "ok",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    {
      "title": "session",
      "description": "Core to module, right after welcome and whenever the live session opens or ends: capture observations tagged with `session` while it is not null.",
      "type": "object",
      "properties": {
        "type": {
          "const": "session"
        },
        "session": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "required": [
        "type",
        "session"
      ],
      "additionalProperties": false
    },
    {
      "title": "observation",
      "description": "Module to Core: one captured event, sent at capture and resent until acknowledged.",
      "type": "object",
      "properties": {
        "type": {
          "const": "observation"
        },
        "envelope": {
          "$ref": "event-envelope.schema.json"
        }
      },
      "required": [
        "type",
        "envelope"
      ],
      "additionalProperties": false
    },
    {
      "title": "ack",
      "description": "Core to module: the observation `id` is recorded (ok, also when it already was) or refused for good (error); either way the module drops it.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "ack"
            },
            "id": {
              "type": "string"
            },
            "ok": {
              "const": true
            }
          },
          "required": [
            "type",
            "id",
            "ok"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "ack"
            },
            "id": {
              "type": "string"
            },
            "ok": {
              "const": false
            },
            "error": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "ok",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    {
      "title": "realise",
      "description": "The Core asks the GM client to realise a desired scene by reconciliation.",
      "type": "object",
      "properties": {
        "type": {
          "const": "realise"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "scene": {
          "type": "string",
          "minLength": 1,
          "description": "The scene's key in the workspace."
        },
        "desired": {
          "$ref": "#/$defs/desired_scene"
        },
        "level": {
          "enum": [
            "manual",
            "propose",
            "act-then-review",
            "autonomous",
            null
          ],
          "description": "The level the module checks against the world's ceiling (DEL-19a): the effective level of the prepare_scene or prepare_document entry that last wrote the desired state; null when the GM last wrote it, by hand or by an undo, which the ceiling does not bound."
        }
      },
      "required": [
        "type",
        "id",
        "scene",
        "desired",
        "level"
      ],
      "additionalProperties": false
    },
    {
      "title": "realise_document",
      "description": "The Core asks the GM client to realise a desired world document by reconciliation, before the scenes, which may refer to it.",
      "type": "object",
      "properties": {
        "type": {
          "const": "realise_document"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "document": {
          "type": "string",
          "minLength": 1,
          "description": "The document's key in the workspace."
        },
        "desired": {
          "$ref": "#/$defs/desired_document"
        },
        "level": {
          "enum": [
            "manual",
            "propose",
            "act-then-review",
            "autonomous",
            null
          ],
          "description": "The level the module checks against the world's ceiling (DEL-19a): the effective level of the prepare_scene or prepare_document entry that last wrote the desired state; null when the GM last wrote it, by hand or by an undo, which the ceiling does not bound."
        }
      },
      "required": [
        "type",
        "id",
        "document",
        "desired",
        "level"
      ],
      "additionalProperties": false
    },
    {
      "title": "realised",
      "description": "The GM client's reconciliation report of a scene or a world document, or why it could not realise it.",
      "type": "object",
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "realised"
            },
            "id": {
              "type": "string"
            },
            "ok": {
              "const": true
            },
            "report": {
              "type": "object",
              "properties": {
                "scene": {
                  "type": "string",
                  "description": "The Foundry id of the Scene."
                },
                "document": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "The Foundry id of the world document; null when it is not in the world (deleted in Foundry and not recreated)."
                },
                "summary": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer"
                  },
                  "description": "How many objects each action took."
                },
                "actions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "action": {
                        "enum": [
                          "create",
                          "update",
                          "delete",
                          "noop",
                          "retouched",
                          "kept-deleted",
                          "conflict"
                        ]
                      },
                      "key": {
                        "type": "string"
                      },
                      "reason": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "action",
                      "key"
                    ],
                    "additionalProperties": false
                  }
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Objects that could not be written, and references (@prepared:) that could not be resolved, each with why."
                }
              },
              "required": [
                "summary",
                "actions",
                "errors"
              ],
              "additionalProperties": false,
              "oneOf": [
                {
                  "required": [
                    "scene"
                  ]
                },
                {
                  "required": [
                    "document"
                  ]
                }
              ]
            }
          },
          "required": [
            "type",
            "id",
            "ok",
            "report"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "realised"
            },
            "id": {
              "type": "string"
            },
            "ok": {
              "const": false
            },
            "error": {
              "type": "string"
            },
            "reason": {
              "const": "ceiling",
              "description": "Present when the world's ceiling refused the realisation (DEL-19a): nothing was read nor written."
            }
          },
          "required": [
            "type",
            "id",
            "ok",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    {
      "title": "traces",
      "description": "GM module to Core: behaviour traces of one consenting user (TRC-02, TRC-05), relayed as captured, about once a second.",
      "type": "object",
      "properties": {
        "type": {
          "const": "traces"
        },
        "user": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{1,64}$",
          "description": "The Foundry user id the traces belong to: the GM's own, or the sender of the Foundry socket message as Foundry reported it."
        },
        "name": {
          "type": "string",
          "description": "The user's name, for the report."
        },
        "gm": {
          "type": "boolean",
          "description": "Whether the user is a GM: their frictions and manual acts count in GM effort, a player's in table friction (TRC-03). False when absent."
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          }
        }
      },
      "required": [
        "type",
        "user",
        "name",
        "records"
      ],
      "additionalProperties": false
    },
    {
      "title": "erase_traces",
      "description": "GM module to Core: the user revoked consent and asked to erase all their past traces (TRC-01).",
      "type": "object",
      "properties": {
        "type": {
          "const": "erase_traces"
        },
        "user": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{1,64}$",
          "description": "The Foundry user id the traces belong to: the GM's own, or the sender of the Foundry socket message as Foundry reported it."
        }
      },
      "required": [
        "type",
        "user"
      ],
      "additionalProperties": false
    },
    {
      "title": "desk",
      "description": "Core to module: what the Director's Desk shows (ARC-14), sent after welcome, whenever it changes and after each gesture.",
      "type": "object",
      "properties": {
        "type": {
          "const": "desk"
        },
        "moment": {
          "enum": [
            "prep",
            "live-session",
            "between-sessions"
          ]
        },
        "session": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/desk_call"
          },
          "description": "The calls due now, still open."
        },
        "decisions": {
          "type": "array",
          "description": "Facts and events recorded from the GM's words, awaiting confirmation at the GM-decision rank (DEL-29).",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "words": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "text",
              "words"
            ],
            "additionalProperties": false
          }
        },
        "turn_driver": {
          "type": [
            "string",
            "null"
          ],
          "description": "The turn driver the last rules context names (RUL-11), null when none is active. While one is, the GM runs GM creatures' turns through it and agents stay silent (RUL-12)."
        },
        "cue": {
          "description": "The active NPC's acting cue (DEL-15), null until an agent shows one. Shown at every level, manual included.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "npc": {
                  "type": "string",
                  "description": "The NPC's entity id."
                },
                "name": {
                  "type": "string"
                },
                "goal": {
                  "type": "string"
                },
                "line": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "A line in the campaign language, its cited facts checked by the Core (CAN-16). Null while a turn driver is active: agents stay silent (RUL-12)."
                },
                "knows": {
                  "type": "array",
                  "description": "The facts the line cites, then further facts the NPC holds.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "statement": {
                        "type": "string"
                      },
                      "mode": {
                        "enum": [
                          "knows",
                          "believes",
                          "suspects"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "statement",
                      "mode"
                    ],
                    "additionalProperties": false
                  }
                },
                "does_not_know": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "statement": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "statement"
                    ],
                    "additionalProperties": false
                  }
                },
                "voiced": {
                  "type": "boolean",
                  "description": "The GM voices this NPC: npcs and disclosure overrides at manual for it, every moment."
                }
              },
              "required": [
                "npc",
                "name",
                "goal",
                "line",
                "knows",
                "does_not_know",
                "voiced"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "type",
        "moment",
        "session",
        "calls",
        "decisions",
        "cue"
      ],
      "additionalProperties": false
    },
    {
      "title": "gesture",
      "description": "Module to Core: a GM gesture on the Director's Desk, an authenticated Surface (ARC-13).",
      "type": "object",
      "properties": {
        "type": {
          "const": "gesture"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Echoed by the result."
        },
        "gesture": {
          "enum": [
            "approve",
            "reject",
            "confirm",
            "break",
            "start_session",
            "end_session",
            "voice",
            "hand_back"
          ]
        },
        "entity": {
          "type": "string",
          "minLength": 1,
          "description": "voice and hand_back: the NPC's entity id."
        },
        "entry": {
          "type": "integer",
          "minimum": 1,
          "description": "approve and reject: the pending action log entry."
        },
        "reason": {
          "enum": [
            "contradiction",
            "rules",
            "tone",
            "other"
          ],
          "description": "reject: the rejection reason (DEL-26)."
        },
        "doc": {
          "type": "string",
          "minLength": 1,
          "description": "confirm: the fact or event id."
        }
      },
      "required": [
        "type",
        "id",
        "gesture"
      ],
      "additionalProperties": false
    },
    {
      "title": "result",
      "description": "Core to module: the gesture `id` was taken (ok), or refused with an error for the GM.",
      "type": "object",
      "properties": {
        "type": {
          "const": "result"
        },
        "id": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "error": {
          "type": "string"
        },
        "pile": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/desk_call"
          },
          "description": "break only: the break pile, open calls due at the break and calls defaulted since the last break (DEL-32)."
        },
        "message": {
          "type": "string",
          "description": "start_session only: what the VTT did for the new session, such as the current date pushed into its clock (CAL-11), for the GM."
        }
      },
      "required": [
        "type",
        "id",
        "ok"
      ],
      "if": {
        "properties": {
          "ok": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "desired_scene": {
      "title": "desired scene",
      "description": "What prep asks a scene to look like (a workspace's scenes/<key>.yaml). The Foundry connector gives the data its meaning: Foundry document fields. A string value \"@prepared:<key>\" stands for a prepared document's id (a Token's actor: its UUID), \"@prepared:<playlist key>/<sound name>\" for a playlist sound's id.",
      "type": "object",
      "properties": {
        "scene": {
          "type": "object",
          "description": "The Scene document's fields, set when it is created and reconciled after.",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name"
          ]
        },
        "items": {
          "type": "array",
          "description": "The objects placed on the scene.",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                "description": "Stable within the scene: it names the object across reconciliations."
              },
              "type": {
                "enum": [
                  "Token",
                  "Wall",
                  "AmbientLight",
                  "AmbientSound",
                  "Note",
                  "Tile",
                  "Drawing",
                  "Region"
                ]
              },
              "actor": {
                "type": "string",
                "minLength": 1,
                "description": "Tokens only: the UUID of the Actor (world or compendium) the token is made from."
              },
              "data": {
                "type": "object",
                "description": "The document's fields."
              }
            },
            "required": [
              "key",
              "type",
              "data"
            ],
            "additionalProperties": false
          }
        },
        "choices": {
          "type": "object",
          "description": "The GM's calls by object key ('_scene' for the scene itself): keep the VTT's version of a conflict, overwrite it, or recreate an object deleted in play.",
          "additionalProperties": {
            "enum": [
              "keep",
              "overwrite",
              "recreate"
            ]
          }
        }
      },
      "required": [
        "scene",
        "items"
      ],
      "additionalProperties": false
    },
    "record": {
      "description": "One behaviour trace record. It says nothing about the fiction: no typed character, no chat text.",
      "oneOf": [
        {
          "title": "semantic",
          "type": "object",
          "properties": {
            "t": {
              "type": "integer",
              "minimum": 0,
              "description": "Milliseconds since the Unix epoch on the capturing client's clock: one clock for both streams."
            },
            "stream": {
              "const": "semantic"
            },
            "event": {
              "type": "string",
